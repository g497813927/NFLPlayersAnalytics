# Relative SQLite file paths are resolved from the backend directory.
DATABASE_URL=sqlite:///data/prototype.db
APP_ENV=development
# Print generated SQL and bound parameters in the API terminal for the demo.
# Set false to silence SQL; restart the backend after changing these flags.
SQL_ECHO=true
SQL_DEBUG_UI=false
# JSON array of browser origins allowed to call FastAPI directly.
CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
