digraph G { graph [rankdir=TB, bgcolor="white", nodesep=0.35, ranksep=0.65, splines=polyline, pad=0.2]; node [shape=plain,fontname="Helvetica",fontsize=12]; edge [dir=forward,arrowhead=vee,arrowsize=0.6,color="#607584",fontname="Helvetica",fontsize=10,labeldistance=2.3, labelangle=25];
app_user [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#607584"><TR><TD BGCOLOR="#e8eef2"><B>app_user</B></TD></TR><HR/><TR><TD ALIGN="LEFT">PK user_id</TD></TR></TABLE>>];
favorite [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#607584"><TR><TD BGCOLOR="#e8eef2"><B>favorite</B></TD></TR><HR/><TR><TD ALIGN="LEFT">PK favorite_id</TD></TR><TR><TD ALIGN="LEFT">FK user_id</TD></TR><TR><TD ALIGN="LEFT">FK sport_id [0..1]</TD></TR><TR><TD ALIGN="LEFT">FK league_id [0..1]</TD></TR><TR><TD ALIGN="LEFT">FK team_id [0..1]</TD></TR><TR><TD ALIGN="LEFT">FK athlete_id [0..1]</TD></TR></TABLE>>];
sport [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#607584"><TR><TD BGCOLOR="#e8eef2"><B>sport</B></TD></TR><HR/><TR><TD ALIGN="LEFT">PK sport_id</TD></TR></TABLE>>];
league [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#607584"><TR><TD BGCOLOR="#e8eef2"><B>league</B></TD></TR><HR/><TR><TD ALIGN="LEFT">PK league_id</TD></TR></TABLE>>];
team [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#607584"><TR><TD BGCOLOR="#e8eef2"><B>team</B></TD></TR><HR/><TR><TD ALIGN="LEFT">PK team_id</TD></TR></TABLE>>];
athlete [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#607584"><TR><TD BGCOLOR="#e8eef2"><B>athlete</B></TD></TR><HR/><TR><TD ALIGN="LEFT">PK athlete_id</TD></TR></TABLE>>];
app_user -> favorite [label="1 : 0..*"];
sport -> favorite [label="0..1 : 0..*"];
league -> favorite [label="0..1 : 0..*"];
team -> favorite [label="0..1 : 0..*"];
athlete -> favorite [label="0..1 : 0..*"];
}