digraph G { graph [rankdir=TB, bgcolor="white", nodesep=0.35, ranksep=0.65, splines=polyline, pad=0.2]; node [shape=plain,fontname="Helvetica",fontsize=12]; edge [dir=forward,arrowhead=vee,arrowsize=0.6,color="#607584",fontname="Helvetica",fontsize=10,labeldistance=2.3, labelangle=25];
sport [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#607584"><TR><TD BGCOLOR="#e8eef2"><B>sport</B></TD></TR><HR/><TR><TD ALIGN="LEFT">PK sport_id</TD></TR></TABLE>>];
league [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#607584"><TR><TD BGCOLOR="#e8eef2"><B>league</B></TD></TR><HR/><TR><TD ALIGN="LEFT">PK league_id</TD></TR><TR><TD ALIGN="LEFT">FK sport_id</TD></TR></TABLE>>];
team [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#607584"><TR><TD BGCOLOR="#e8eef2"><B>team</B></TD></TR><HR/><TR><TD ALIGN="LEFT">PK team_id</TD></TR><TR><TD ALIGN="LEFT">FK league_id</TD></TR></TABLE>>];
season [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#607584"><TR><TD BGCOLOR="#e8eef2"><B>season</B></TD></TR><HR/><TR><TD ALIGN="LEFT">PK season_id</TD></TR><TR><TD ALIGN="LEFT">FK league_id</TD></TR></TABLE>>];
roster [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#607584"><TR><TD BGCOLOR="#e8eef2"><B>roster</B></TD></TR><HR/><TR><TD ALIGN="LEFT">PK roster_id</TD></TR><TR><TD ALIGN="LEFT">FK team_id</TD></TR><TR><TD ALIGN="LEFT">FK season_id</TD></TR></TABLE>>];
membership [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#607584"><TR><TD BGCOLOR="#e8eef2"><B>membership</B></TD></TR><HR/><TR><TD ALIGN="LEFT">PK membership_id</TD></TR><TR><TD ALIGN="LEFT">FK roster_id</TD></TR><TR><TD ALIGN="LEFT">FK athlete_id</TD></TR></TABLE>>];
athlete [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#607584"><TR><TD BGCOLOR="#e8eef2"><B>athlete</B></TD></TR><HR/><TR><TD ALIGN="LEFT">PK athlete_id</TD></TR></TABLE>>];
sport -> league [label="1 : 0..*"];
league -> team [label="1 : 0..*"];
league -> season [label="1 : 0..*"];
team -> roster [label="1 : 0..*"];
season -> roster [label="1 : 0..*"];
roster -> membership [label="1 : 0..*"];
athlete -> membership [label="1 : 0..*"];
}