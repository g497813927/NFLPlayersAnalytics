{
  "name": "nfl-players-analytics",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "concurrently --kill-others --success first --names API,Web --prefix-colors blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "uv run --directory backend --frozen uvicorn app.main:app --host 127.0.0.1 --port 8000",
    "dev:web": "npm --prefix frontend run dev -- --port 5173 --strictPort"
  },
  "devDependencies": {
    "concurrently": "10.0.6"
  }
}
