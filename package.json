{
  "name": "nfl-players-analytics",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "concurrently --kill-others --success first --names API,Web --prefix-colors blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "uv run --directory backend --frozen uvicorn app.main:app --no-proxy-headers --host 127.0.0.1 --port 8000",
    "dev:web": "npm --prefix frontend run dev -- --port 5173 --strictPort",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "npm run lint:js && npm run lint:css",
    "lint:js": "eslint . --max-warnings 0",
    "lint:css": "stylelint \"frontend/src/**/*.css\" --max-warnings 0",
    "format:python": "uv run --directory backend --frozen ruff format app scripts",
    "format:python:check": "uv run --directory backend --frozen ruff format --check app scripts",
    "lint:python": "uv run --directory backend --frozen ruff check app scripts",
    "check": "npm run format:check && npm run lint && npm run build --prefix frontend && npm run format:python:check && npm run lint:python && uv run --directory backend --frozen python -m compileall -q app scripts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "concurrently": "10.0.6",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "stylelint": "16.26.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    },
    "eslint": {
      "minimatch": "^11.0.1"
    },
    "@eslint/config-array": {
      "minimatch": "^11.0.1"
    }
  }
}
